{
  "name": "scribe",
  "productName": "Scribe",
  "version": "0.1.0",
  "description": "Turn any video into a full transcript on your own computer.",
  "author": "Hosea",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "app": "vite build && electron .",
    "app:dev": "concurrently -k \"vite --port 5174 --strictPort\" \"wait-on http://localhost:5174 && cross-env SCRIBE_DEV=http://localhost:5174 electron .\"",
    "check": "tsx scripts/check.ts",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "docx": "9.11.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "wait-on": "9.5.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "onnxruntime-node": false,
    "protobufjs": false,
    "electron-winstaller": false
  },
  "build": {
    "appId": "io.github.scribe.transcript",
    "productName": "Scribe",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}
